<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ru.rudoy.loadprofile</groupId>
    <artifactId>vkr-load-profile</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>vkr-load-profile</name>
    <description>Построение профиля нагрузки по данным распределённой трассировки и генерация плана теста Apache JMeter</description>

    <modules>
        <module>profiler</module>
        <module>demo-stand</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <picocli.version>4.7.7</picocli.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Версии Spring Boot и его зависимостей задаёт родительский POM.
                 Здесь перечислены только библиотеки, которых в нём нет. -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-spring-boot-starter</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
